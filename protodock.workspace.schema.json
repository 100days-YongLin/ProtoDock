{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100days-yonglin.github.io/ProtoDock/protodock.workspace.schema.json",
  "title": "ProtoDock Product Workspace",
  "type": "object",
  "required": ["schemaVersion", "product", "projects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "product": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": {
          "type": "string",
          "description": "Coordinated product release version shared by every endpoint published in the same release."
        }
      }
    },
    "sharedDocs": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative directory containing direct product-wide Markdown contracts. Defaults to shared-docs."
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "description": "Independent, complete ProtoDock endpoint project roots. Workspace support never merges child manifests or Canvas state.",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

<view class="page">
  <text>{{message}}</text>
  <button bindtap="changeMessage">切换文案</button>
  <image id="dynamic-asset" src="/assets/probe.svg" mode="aspectFit" />
  <scroll-view class="scroll-probe" scroll-y="true" data-scroll-probe="true">
    <view class="scroll-probe-content">可滚动内容</view>
  </scroll-view>
  <view class="nested-scroll-layout">
    <scroll-view class="nested-scroll-outer" scroll-y="true" data-nested-scroll-outer="true">
      <view class="nested-scroll-section">
        <scroll-view class="nested-scroll-horizontal" scroll-x="true" data-nested-scroll-inner="true">
          <view class="wide-timetable">固定宽横向课表</view>
        </scroll-view>
      </view>
    </scroll-view>
  </view>
  <view class="bottom-sheet-mask" data-style-probe="mask">
    <view class="bottom-sheet-panel" data-style-probe="panel">弹窗内容</view>
  </view>
  <apply-shared-probe />
  <input data-digit-probe="true" type="digit" value="36.5" />
  <slider data-slider-probe="true" min="36" max="39" step="0.1" value="36.5" activeColor="#ff7300" block-color="#ee6600" bindchanging="sliderChanging" bindchange="sliderChanged" />
  <text data-slider-events="true">{{sliderEvents}}</text>
  <picker data-picker-probe="true" range="{{['same', 'same', 'other']}}" />
  <view wx:for="{{report.items}}" wx:key="id" data-optional-list="true">{{item.label}}</view>
</view>

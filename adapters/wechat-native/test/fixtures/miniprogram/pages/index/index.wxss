.page {
  display: flex;
  min-height: 160vh;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 24rpx;
}

.scroll-probe {
  display: block;
  width: 160rpx;
  height: 80rpx;
}

.scroll-probe-content {
  height: 240rpx;
}

.bottom-sheet-mask {
  background: var(--hm-color-mask);
}

.bottom-sheet-panel {
  background: var(--hm-color-surface-warm);
  color: var(--hm-color-text);
}

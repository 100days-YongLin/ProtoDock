{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100days-yonglin.github.io/ProtoDock/protodock.project.schema.json",
  "title": "ProtoDock Project Manifest",
  "type": "object",
  "required": ["schemaVersion", "project", "pages", "canvas"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "devicePreset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "safeAreaEnabled": { "type": "boolean" },
        "safeAreaTop": { "type": "number", "minimum": 0, "maximum": 240 },
        "safeAreaBottom": { "type": "number", "minimum": 0, "maximum": 240 },
        "devicePreset": {
          "type": "string",
          "enum": [
            "web-landscape",
            "web-portrait",
            "iphone-portrait",
            "iphone-landscape",
            "ipad-portrait",
            "ipad-landscape"
          ]
        }
      }
    },
    "changelog": {
      "type": "array",
      "description": "Append-only release history. The final item is the current published version.",
      "items": {
        "type": "object",
        "required": ["version", "changedAt", "description"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "changedAt": { "type": "string", "format": "date-time" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1200, "description": "Non-empty release summary; 用户体验, 产品调整, and 前后端逻辑 sections are recommended but optional." }
        }
      }
    },
    "pendingChanges": {
      "type": "array",
      "description": "Unreleased edits accumulated by local saves and cleared by a successful publish.",
      "items": {
        "type": "object",
        "required": ["changedAt", "description"],
        "additionalProperties": false,
        "properties": {
          "changedAt": { "type": "string", "format": "date-time" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1200, "description": "Non-empty unreleased summary; sectioned bullets are recommended but optional." }
        }
      }
    },
    "workspaceSnapshot": {
      "type": "object",
      "description": "Read-only product-workspace metadata embedded only in a published endpoint snapshot.",
      "required": ["product", "project", "sharedDocs"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": "object",
          "required": ["id", "name", "version"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "project": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "sharedDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^docs/_shared/.+\\.md$" }
            }
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "entry", "doc"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "tag": { "type": "string" },
          "sourceDir": { "type": "string" },
          "entry": { "type": "string", "minLength": 1 },
          "doc": { "type": "string" }
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pageId", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "pageId": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "fromSide": { "$ref": "#/$defs/side" },
              "toSide": { "$ref": "#/$defs/side" }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "rootNodeId", "nodeIds"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "rootNodeId": { "type": "string", "minLength": 1 },
              "nodeIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "collapsed": {
                "type": "boolean",
                "description": "Whether this group is collapsed in the left page list. Canvas nodes and edges remain fully visible."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "string",
      "enum": ["top", "right", "bottom", "left"]
    }
  }
}
